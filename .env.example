# copy this file to backend/.env and fill in your own key. .env is git-ignored.
#
# any free "OpenAI-compatible" provider works. pick ONE block.

# --- Groq (free tier, very fast) - key from https://console.groq.com/keys
# models get retired: the server checks at start-up and prints the list if this one is gone.
# (checked 2026-10-13: llama-3.3-70b-versatile is gone, openai/gpt-oss-120b works)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
LLM_API_KEY=

# --- Google Gemini (free tier) - key from https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash
# LLM_REASONING_EFFORT=
# LLM_API_KEY=

# --- Ollama on your own machine (free, offline) - no key needed, but must not be empty
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
# LLM_REASONING_EFFORT=
# LLM_API_KEY=ollama

# optional
# EXPLAIN_LIMIT=20          # explanations per visitor ...
# EXPLAIN_WINDOW_S=600      # ... per 10 minutes
